# ==================== 服务基础配置 ====================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=True

# ==================== JWT鉴权配置 ====================
# 生产环境请务必更换为强密钥！！！
JWT_SECRET_KEY=your_strong_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7天有效期

# ==================== 智谱AI大模型配置 ====================
# 请替换为你自己的智谱AI API Key
# 免费获取地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=f433d2ba8a6148a3b5c515fd63ffb774.yebRd3E0WGa4mHUA
ZHIPU_MODEL_NAME=glm-4-flash

# ==================== 嵌入模型配置 ====================
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ==================== 向量库配置 ====================
FAISS_INDEX_PATH=./data/faiss/rag_index.faiss
DOC_MAP_PATH=./data/faiss/doc_id_map.json

# ==================== 数据库配置 ====================
# SQLite数据库文件路径
